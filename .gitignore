# Model checkpoints (root and inside experiment dirs)
Wan2.1-*/
Wan2.1-*
checkpoints/

# UVG raw data
data/
UVG/

# Experiment outputs — KEEP metrics JSON / summary.json / .tdcm bitstreams,
# EXCLUDE bulky media (.mp4, .png, .log handled by their own rules below).
# We do NOT blanket-ignore results dirs anymore so JSON metadata can be tracked.
outputs/
sweep_*/
codec_benchmark*/
diagnose_output/
i2v_experiment*/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.eggs/
.eggs/

# Environment
.env
*.env
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# PyTorch checkpoint files
*.pt
*.pth
*.ckpt
*.safetensors

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
wandb/

# Claude Code
.claude/

# Local index stub (real Claude memory lives elsewhere)
MEMORY.md

# Local sandbox scripts
exp_*/test_*.py
exp_*/smoke_*.py

# Local /tmp parsing artifacts
*_parsed.json

# Media outputs (videos / images) — too large for GitHub. Keep .tdcm bitstreams
# (codebook indices) since they ARE the compressed payload (small).
*.mp4
*.png

# LaTeX intermediate / build artifacts (keep .tex + .bib + .sty + .bst + a
# tagged draft PDF in paper/; rebuild outputs on the fly via tectonic).
paper/main.aux
paper/main.log
paper/main.out
paper/main.bbl
paper/main.blg
paper/main.toc
paper/main.synctex.gz
paper/main.pdf

# Also drop top-level .aux etc if anyone compiles in root
*.aux
*.log
*.out
*.bbl
*.blg
*.toc
*.synctex.gz

# Allow the qualitative demo bundled with the release
!demo/*.mp4
!demo/*.png
